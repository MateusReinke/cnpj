# Porta do servidor (o Coolify já injeta essa variável automaticamente)
PORT=8080

# OpenAI (opcional) — usada para gerar sugestões de nota fiscal com IA real
# na aba "IA" do app. Sem essas variáveis, o app usa uma base de regras
# local, gratuita, como alternativa (fallback automático).
#
# A chave NUNCA é enviada para o navegador: as chamadas à OpenAI acontecem
# só no servidor (server.js). Também é possível configurar (ou sobrescrever)
# a chave e o modelo direto pela aba "IA" do app, sem precisar redeployar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
