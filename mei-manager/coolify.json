{
  "name": "mei-manager",
  "description": "App de gestão para MEI com controle de CNPJs, contas a pagar e emissão de notas fiscais",
  "version": "1.0.0",
  "type": "dockerfile",
  "dockerfile": {
    "path": "Dockerfile",
    "target": "",
    "build_args": []
  },
  "ports": [
    {
      "port": 8080,
      "protocol": "http",
      "public": true
    }
  ],
  "environment_variables": [
    {
      "key": "PORT",
      "value": "8080",
      "description": "Porta do servidor web"
    }
  ],
  "health_check": {
    "path": "/",
    "port": 8080,
    "interval": 30,
    "timeout": 5,
    "retries": 3
  },
  "resources": {
    "cpu": "0.5",
    "memory": "512M"
  },
  "domains": [],
  "redirects": [],
  "security": {
    "allowed_methods": ["GET", "POST"],
    "cors_origins": ["*"]
  }
}
